# --- OpenAI (required for the agent) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Database ---
# Default: SQLite file in ./data (created and seeded automatically).
# DATABASE_URL=sqlite:///data/querypilot.db
# Postgres (install with `uv sync --extra postgres`):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/querypilot

# --- Agent behaviour ---
# CHROMA_PATH=data/chroma
# MEMORY_ENABLED=true
# MEMORY_TOP_K=5
# MEMORY_MAX_DISTANCE=0.55
# EMBEDDING_MODEL=text-embedding-3-small
# MAX_TOOL_ITERATIONS=5
# MAX_RESULT_ROWS=200
# QUERY_TIMEOUT_SECONDS=15
# LOG_LEVEL=INFO

# --- Web UI ---
# SERVER_HOST=127.0.0.1
# SERVER_PORT=7860
